+    def test_restore_leaves_blocks_for_running_decode(self):
+        scheduler, transport = self.scheduler(blocks=4)
+        a = self.sequence([1] * 256)
+        c = self.sequence([2])
+        b = self.sequence([3] * 300)
+        self.prefill(scheduler, transport, [a, c, b])
+        self.preempt(scheduler, b)
+        transport.advance()
+        # B fits alone in the two free blocks; A needs one of them to decode.
+        self.assertTrue(scheduler.offload.can_restore(b))
+        batch, phase = scheduler.schedule()
+        self.assertFalse(phase)
+        self.assertEqual(batch, [a, c])
+        self.assertEqual(b.status, SequenceStatus.WAITING_RESTORE)
+        self.assertEqual(scheduler.offload.stats["restored_sequences"], 0)
+        self.assertEqual(scheduler.offload.stats["offloaded_sequences"], 1)
+        self.compute(scheduler, transport, batch, phase)
+        # Once A finishes and releases its pages, B can resume normally.
+        a.max_tokens = a.num_completion_tokens + 1
+        batch, phase = scheduler.schedule()
+        self.compute(scheduler, transport, batch, phase)
+        self.assertTrue(a.is_finished)
+        for _ in range(3):
+            transport.advance()
+            batch, phase = scheduler.schedule()
+            self.assertFalse(phase)
+            self.compute(scheduler, transport, batch, phase)
+            if b in batch:
+                break
+        self.assertIn(b, batch)
